<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="header__cart">
      {{ 'icon-cart.svg' | inline_asset_content }}

      <!-- Cart Bubble -->
      <span id="CartCount" class="cart-count-bubble {% if cart.item_count == 0 %}hidden{% endif %}">
        {%- if cart.item_count > 99 -%}
          **
        {%- else -%}
          {{ cart.item_count }}
        {%- endif -%}
      </span>
    </a>
  </div>
</header>

<script>
  // Global Cart Event Listener
  document.addEventListener('cart:updated', async () => {
    try {
      const res = await fetch(`${window.Shopify?.routes?.root || '/'}cart.js`);
      const cart = await res.json();
      const countElement = document.getElementById('CartCount');

      if (countElement) {
        if (cart.item_count > 0) {
          countElement.textContent = cart.item_count > 99 ? '**' : cart.item_count;
          countElement.classList.remove('hidden');
        } else {
          countElement.classList.add('hidden');
        }
      }
    } catch (e) {
      console.error('Failed to fetch global cart count', e);
    }
  });
</script>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
